# =============================================================
# MediLoop Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://mediloop:mediloop_password@localhost:5432/mediloop_dev

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_here_min_64_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── AI Provider ──────────────────────────────────────────────
# Supported: openai | anthropic | gemini | groq | mock
AI_PROVIDER=groq
AI_API_KEY=your_ai_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.2-11b-vision-preview
AI_MAX_RETRIES=3

# ── OCR Provider ─────────────────────────────────────────────
# Supported: tesseract | google-vision | aws-textract | groq | mock
OCR_PROVIDER=groq
OCR_API_KEY=your_ocr_api_key_here

# ── File Storage ─────────────────────────────────────────────
# Supported: local | s3 | gcs
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mediloop-files

# ── Email ────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@mediloop.app
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=MediLoop
EMAIL_FROM_ADDRESS=noreply@mediloop.app

# ── Push Notifications ───────────────────────────────────────
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# ── Admin Dashboard ──────────────────────────────────────────
ADMIN_SECRET=your_admin_secret_here

# ── Analytics ────────────────────────────────────────────────
ANALYTICS_ENABLED=false
# POSTHOG_API_KEY=
