{
  "expo": {
    "name": "MediLoop",
    "slug": "mediloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mediloop.ios",
      "infoPlist": {
        "NSCameraUsageDescription": "MediLoop needs camera access to scan prescription documents.",
        "NSPhotoLibraryUsageDescription": "MediLoop needs photo library access to upload prescription images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "app.mediloop.android",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F46E5",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MediLoop needs camera access to scan prescriptions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MediLoop needs access to your photos to upload prescriptions."
        }
      ]
    ],
    "scheme": "mediloop",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "mediloop-project-id"
      }
    }
  }
}
